# ============================================================
#  HPC-3 提交工程 .gitignore
#  原则：源码 + 测试 + 证据文本进仓库；数据集/输出/可执行文件不进
# ============================================================

# ---------- 数据集：生成一次即固化，体积大，永不提交 ----------
data/
*.bin

# ---------- 参考输出 / 实验输出 ----------
gold/
out/
*.out

# ---------- 构建产物与可执行文件 ----------
build/
bench/baseline
bench/optimized
bench/micro_variants
bench/optimized-asan
*.o
*.obj
*.exe
*.out.exe
a.out

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo

# ---------- 编辑器 / 备份 / 系统垃圾 ----------
*.swp
*.swo
*~
*.bak
.DS_Store

# ---------- 第三轮的临时复现输出目录（正式证据已归档到 results/*.txt）----------
results/ab-live/

# ---------- 例外：results/ 里的证据文本必须提交 ----------
!results/*.txt
!results/*.json
!results/*.md
